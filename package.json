{
  "name": "streamist",
  "version": "0.1.0",
  "private": true,
  "description": "Multiple Twitch stream viewer built with Vue",
  "author": "Daniel Hearn",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "test:unit": "vue-cli-service test:unit",
    "lint": "vue-cli-service lint",
    "deploy": "vue-cli-service build && gh-pages -d dist",
    "build-storybook": "build-storybook",
    "storybook": "start-storybook -p 6006",
    "test": "jest",
    "update-snapshots": "jest --updateSnapshot"
  },
  "dependencies": {
    "core-js": "^3.8.3",
    "vue": "^2.6.14",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.18.6",
    "@babel/eslint-parser": "^7.12.16",
    "@babel/preset-env": "^7.18.6",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-unit-jest": "~5.0.0",
    "@vue/cli-plugin-vuex": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/test-utils": "^1.3.0",
    "@vue/vue2-jest": "^27.0.0-alpha.2",
    "autoprefixer": "^10.4.7",
    "babel-core": "^7.0.0-bridge.0",
    "babel-jest": "^28.1.2",
    "date-fns": "^2.28.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-vue": "^8.0.3",
    "jest": "^28.1.2",
    "lodash": "^4.17.21",
    "prettier": "^2.7.1",
    "sass": "^1.53.0",
    "sass-loader": "^13.0.2",
    "vue-jest": "^3.0.7",
    "vue-select": "^3.18.3",
    "vue-template-compiler": "^2.6.14",
    "vuedraggable": "^2.24.3",
    "yup": "^0.32.11"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {},
    "overrides": [
      {
        "files": [
          "**/__tests__/*.{j,t}s?(x)",
          "**/tests/unit/**/*.spec.{j,t}s?(x)"
        ],
        "env": {
          "jest": true
        }
      }
    ]
  },
  "browserslist": [
    "> 0.25%",
    "not dead"
  ],
  "bugs": {
    "url": "https://github.com/DanielHearn/streamist/issues"
  },
  "gh-pages-deploy": {
    "staticpath": "dist",
    "commit": "Deploy to gh-pages",
    "noprompt": false
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanielHearn/streamist.git"
  }
}
